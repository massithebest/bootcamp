# =============================================================
# Production Planning Agent Backend - 환경변수 예시
# 실제 값은 .env 로 복사해서 사용한다. (.env 는 커밋하지 않는다)
#   cp .env.example .env
# =============================================================

# ---- 애플리케이션 ----
ENV=dev
# mock | production. 기존 SERVICE_MODE=real 설정도 호환됩니다.
SERVICE_MODE=mock

# 폐쇄망 production API 요청 timeout(초). production adapter 이식 후 사용한다.
API_TIMEOUT_SECONDS=60

# 도메인 지식 YAML 루트. 개발 환경에서 비우면 backend/knowledge/mock을 쓴다.
# ENV=prod에서는 backend/knowledge/production 또는 별도 운영 디렉터리를 반드시 지정한다.
KNOWLEDGE_DIR=

# 개발용 합성 mock SQLite 경로. ENV=prod에서는 사용하지 않는다.
# 비워두면 backend/data/mock_planning.db 를 쓴다.
#   생성: python -m scripts.generate_mock_database
MOCK_DB_PATH=

# 조회 결과(parquet) 저장 디렉터리. 비워두면 backend/data/results 를 쓴다.
RESULT_STORE_DIR=

# 조회 결과 보존 시간. 비워두면 24시간을 쓴다.
RESULT_STORE_TTL_HOURS=
# 조회 결과 저장소 최대 크기(bytes). 비워두면 500MB를 쓴다.
RESULT_STORE_MAX_BYTES=

# 브라우저 쿠키를 허용할 명시적 Frontend Origin 목록(콤마 구분).
# 운영에서는 실제 HTTPS 사내망 Origin으로 반드시 재정의한다.
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Claude Code CLI(`claude`) 경로. 비워두면 PATH 에서 자동 탐색한다.
# 별도 CLI를 쓸 때만 실행 파일의 경로를 지정한다.
CLAUDE_CLI_PATH=

# 백엔드 자신이 기동하는 포트. uvicorn --port 값과 반드시 일치해야 한다.
# LLM_PROVIDER=local일 때 /anthropic 프록시의 자기 참조 URL 구성에 쓰인다.
BACKEND_PORT=8100


# ---- LLM Provider ----
# anthropic | openrouter | local
LLM_PROVIDER=anthropic

# Agent SDK가 다음 LLM 응답 이벤트를 기다리는 최대 시간(초).
LLM_RESPONSE_TIMEOUT_SECONDS=30

# Agent 가 사용할 모델. 비워두면 Claude Code 기본값 사용.
#   anthropic  예: claude-sonnet-4-5
#   openrouter 예: anthropic/claude-sonnet-4.5, deepseek/deepseek-chat
#   local      비워두면 PRIVATE_LLM_MODEL_NAME 을 쓴다.
AGENT_MODEL=


# ---- LLM_PROVIDER=anthropic 일 때 ----
ANTHROPIC_API_KEY=


# ---- LLM_PROVIDER=openrouter 일 때 ----
# https://openrouter.ai/keys 에서 발급 (sk-or-v1-...)
OPENROUTER_API_KEY=
# 보통 그대로 둔다. (반드시 /api, /api/v1 아님)
OPENROUTER_BASE_URL=https://openrouter.ai/api


# ---- LLM_PROVIDER=local 일 때 ----
# 사내 LLM 게이트웨이(HCP)가 Claude CLI User-Agent를 차단할 때 쓴다. CLI 요청은
# 백엔드 자신의 /anthropic 프록시로 가고, 거기서 User-Agent만 교체해 아래
# endpoint로 전달한다. 실제 모델명·endpoint·key는 폐쇄망 .env에만 채운다.
PRIVATE_LLM_MODEL_NAME=
PRIVATE_LLM_MODEL_ENDPOINT=
PRIVATE_LLM_MODEL_KEY=


# ---- SERVICE_MODE=production 어댑터 (이식 후 사용) ----
# 사내 공통 SQL 실행 API, Simulation API, Milvus, 임베딩·재랭커, RAG 문서 base
# URL. 실제 사내 IP·URL은 이 파일이 아닌 backend/.env에만 채운다.
COMMON_SQL_API_URL=
SIMULATION_API_URL=
MILVUS_HOST=
MILVUS_PORT=
MILVUS_COLLECTION=
IFLOW_EMBEDDING_ENDPOINT=
IFLOW_EMBEDDING_KEY=
RERANKER_ENDPOINT=
RAG_DOC_URL_BASE=

# 텍스트 지식 저장소. 비우면 backend/data/knowledge.sqlite3를 사용한다.
KNOWLEDGE_DB_PATH=
KNOWLEDGE_SEARCH_BACKEND=local

# 구조화 지식(YAML) 변경 요청·승인. 인증 체계 전까지의 스텁 설정이다.
# false 이면 변경 요청의 쓰기 동작을 막고 조회만 허용한다.
KNOWLEDGE_MANAGEMENT_ENABLED=true
# 작성자가 자신의 변경 요청을 승인하도록 허용할지 여부. 기본은 차단한다.
KNOWLEDGE_ALLOW_SELF_APPROVAL=false
# {id: {name, permissions[]}} JSON. 권한은 knowledge:write, knowledge:approve.
# 비우면 사용자(user: write)와 관리자(admin: write+approve) 기본값을 쓴다.
KNOWLEDGE_PRINCIPALS=
# X-User-Id 헤더가 없을 때 쓰는 id. 비우면 권한이 가장 적은 항목을 쓴다.
KNOWLEDGE_DEFAULT_PRINCIPAL=

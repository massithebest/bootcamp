{
  "$comment": "Backend services/present_service.py의 present_*_input_schema() 사본. Backend 계약을 바꾸면 함께 갱신한다.",
  "tools": {
    "present_sql_preview": {
      "props": {
        "sql": {
          "maxLength": 20000,
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "type": "string"
        }
      },
      "required": [
        "sql"
      ]
    },
    "present_chart": {
      "props": {
        "aggregation": {
          "enum": [
            "sum",
            "avg",
            "count",
            "min",
            "max"
          ],
          "type": "string"
        },
        "chart_type": {
          "enum": [
            "bar",
            "line",
            "area"
          ],
          "type": "string"
        },
        "group_by_column": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_id": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "type": "string"
        },
        "x_column": {
          "maxLength": 200,
          "type": "string"
        },
        "y_column": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "chart_type",
        "x_column",
        "y_column"
      ]
    },
    "present_table": {
      "props": {
        "columns": {
          "maxItems": 50,
          "type": "array"
        },
        "result_id": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "type": "string"
        }
      },
      "required": [
        "result_id"
      ]
    },
    "present_simulation": {
      "props": {
        "kpis": {
          "maxItems": 12,
          "type": "array"
        },
        "result_id": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "scenario": {
          "maxLength": 200,
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "summary",
        "kpis"
      ]
    }
  }
}
